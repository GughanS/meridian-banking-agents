LLM_PROVIDER=mock
# LLM_PROVIDER=gemini
# GEMINI_API_KEY=your_api_key_here

DATABASE_URL=sqlite+aiosqlite:///meridian.db
CORE_BASE_URL=http://localhost:8001/mock-core/v1

DEFAULT_CURRENCY=INR
RATE_LIMIT_PER_MIN=60
LLM_TIMEOUT_S=30
LLM_MAX_RETRIES=3
LLM_MODEL_FALLBACK=gemini-3.0-pro
LLM_MONITOR_BUDGET_PER_MIN=6

SIM_ENABLED=true
SIM_TX_INTERVAL_S=6
SIM_ANOMALY_RATE=0.08

CORE_LATENCY_MS=0
CORE_ERROR_RATE=0.0
FRAUD_ALERT_THRESHOLD=70
